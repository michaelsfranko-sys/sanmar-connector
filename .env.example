SANMAR_SFTP_HOST=ftp.sanmar.com
SANMAR_SFTP_PORT=2200
SANMAR_SFTP_USERNAME=your_sanmar_customer_number
SANMAR_SFTP_PASSWORD=your_sanmar_ftp_password
SANMAR_EPDD_REMOTE_PATH=/SanMar_EPDD.csv
SANMAR_DIP_REMOTE_PATH=/sanmar_dip.txt
SANMAR_CACHE_DIR=/tmp/sanmar

# Optional legacy/single-store Shopify configuration.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_DEFAULT_STORE=quality-image

# Quality Image Shopify connection.
QUALITY_IMAGE_SHOPIFY_STORE_DOMAIN=
QUALITY_IMAGE_SHOPIFY_CLIENT_ID=
QUALITY_IMAGE_SHOPIFY_CLIENT_SECRET=
QUALITY_IMAGE_SHOPIFY_API_VERSION=2026-07

# Prestige Custom Creations Shopify connection.
PRESTIGE_SHOPIFY_STORE_DOMAIN=
PRESTIGE_SHOPIFY_CLIENT_ID=
PRESTIGE_SHOPIFY_CLIENT_SECRET=
PRESTIGE_SHOPIFY_API_VERSION=2026-07

# Protects write-capable connector endpoints.
CONNECTOR_API_KEY=
